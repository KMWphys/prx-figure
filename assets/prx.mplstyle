# APS Physical Review / PRX figure style for matplotlib.
# Sizes are for figures drawn at their FINAL printed width (see prx_style.figsize).

# --- Figure -----------------------------------------------------------------
figure.figsize          : 3.375, 2.53     # single column (8.5 cm), aspect 0.75
figure.dpi              : 150
figure.constrained_layout.use : True
figure.constrained_layout.h_pad : 0.02
figure.constrained_layout.w_pad : 0.02
savefig.dpi             : 600
savefig.format          : pdf
savefig.transparent     : False

# --- Fonts (smallest caps must be >= 2 mm => >= ~8.5 pt) ----------------------
font.family             : serif
font.serif              : STIXGeneral, Times New Roman, Times, DejaVu Serif
mathtext.fontset        : stix
font.size               : 9
axes.labelsize          : 10
axes.titlesize          : 10
xtick.labelsize         : 9
ytick.labelsize         : 9
legend.fontsize         : 9
legend.title_fontsize   : 9
figure.titlesize        : 10
axes.formatter.use_mathtext : True
axes.unicode_minus      : True
pdf.fonttype            : 42             # embed TrueType, editable text
ps.fonttype             : 42

# --- Lines and markers (curves >= 0.5 pt, points >= 1 mm = 2.83 pt) -----------
lines.linewidth         : 1.0
lines.markersize        : 4
lines.markeredgewidth   : 0.8
errorbar.capsize        : 1.5
patch.linewidth         : 0.6
hatch.linewidth         : 0.8

# Okabe-Ito colors, each paired with a different line style so curves stay
# distinguishable in grayscale print.
axes.prop_cycle : (cycler('color', ['000000', '0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9']) + cycler('linestyle', ['-', '--', '-.', ':', (0, (5, 1, 1, 1)), (0, (3, 1, 1, 1, 1, 1)), (0, (1, 1))]))

# --- Axes and ticks -----------------------------------------------------------
axes.linewidth          : 0.6
axes.grid               : False
axes.spines.top         : True
axes.spines.right       : True
axes.labelpad           : 2.0
xtick.direction         : in
ytick.direction         : in
xtick.top               : True
ytick.right             : True
xtick.major.size        : 3.5
ytick.major.size        : 3.5
xtick.minor.size        : 2.0
ytick.minor.size        : 2.0
xtick.major.width       : 0.6
ytick.major.width       : 0.6
xtick.minor.width       : 0.5
ytick.minor.width       : 0.5
xtick.minor.visible     : True
ytick.minor.visible     : True
xtick.major.pad         : 2.5
ytick.major.pad         : 2.5

# --- Legend -------------------------------------------------------------------
legend.frameon          : False
legend.handlelength     : 2.2
legend.handletextpad    : 0.5
legend.borderaxespad    : 0.4
legend.labelspacing     : 0.3

# --- Images -------------------------------------------------------------------
image.cmap              : viridis
image.interpolation     : none           # embed data pixels as-is (small EPS/PDF)
